# =============================================================================
# XPilot — Environment Variables
# Copy this file to .env in the project root, then fill in values.
# =============================================================================

# ---------------------------------------------------------------------------
# X Layer Testnet (primary dev / hackathon chain)
# ---------------------------------------------------------------------------
X_LAYER_TESTNET_RPC=https://testrpc.xlayer.tech
# Private key for the deployer / agent EOA
# WARNING: Never commit a real key. Use a dedicated hot wallet with limited funds.
PRIVATE_KEY=0x_your_private_key_here

# Deployed contract addresses (filled in after deployment)
DECISION_LOG_ADDRESS=0x_
COPILOT_REGISTRY_ADDRESS=0x_

# ---------------------------------------------------------------------------
# X Layer Mainnet (for production)
# ---------------------------------------------------------------------------
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_MAINNET_DECISION_LOG_ADDRESS=0x_
XLAYER_MAINNET_COPILOT_REGISTRY_ADDRESS=0x_

# ---------------------------------------------------------------------------
# OKLink Explorer API Key (for contract verification)
# Get one free at: https://www.oklink.com → My Account → API Management
# ---------------------------------------------------------------------------
OKLINK_API_KEY=your_oklink_api_key

# ---------------------------------------------------------------------------
# OKX DEX API (Wallex trading endpoints)
# ---------------------------------------------------------------------------
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_API_PASSPHRASE=your_okx_passphrase
OKX_API_BASE_URL=https://www.okx.com

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Which AI provider to use: "deepseek" | "anthropic" | "openai"
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible API — recommended default)
DEEPSEEK_API_KEY=sk-your_deepseek_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (GPT)
OPENAI_API_KEY=sk-your_openai_key
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Agent Configuration
# ---------------------------------------------------------------------------
# How often the agent scans for trading opportunities (in milliseconds)
AGENT_SCAN_INTERVAL_MS=60000
# Minimum confidence threshold (0-100) before a trade is executed
AGENT_MIN_CONFIDENCE=75
# Max trade size in USD (safety cap)
AGENT_MAX_TRADE_USD=1000
# Log level: debug | info | warn | error
AGENT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Data Providers (optional — for enriched market analysis)
# ---------------------------------------------------------------------------
COINGECKO_API_KEY=your_coingecko_key

# ---------------------------------------------------------------------------
# Web Frontend (Next.js — prefixed with NEXT_PUBLIC_ for client exposure)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_X_LAYER_TESTNET_RPC=https://testrpc.xlayer.tech
NEXT_PUBLIC_DECISION_LOG_ADDRESS=0x_
NEXT_PUBLIC_COPILOT_REGISTRY_ADDRESS=0x_
